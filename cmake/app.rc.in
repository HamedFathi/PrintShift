#include <windows.h>
1 RT_MANIFEST "@PROJECT_BINARY_DIR@/generated/app.manifest"
1 ICON "@PROJECT_SOURCE_DIR@/app.ico"
1 VERSIONINFO
FILEVERSION @PRINTSHIFT_VERSION_RC@
PRODUCTVERSION @PRINTSHIFT_VERSION_RC@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "PrintShift - Print Screen shortcut manager\0"
      VALUE "FileVersion", "@PRINTSHIFT_VERSION@\0"
      VALUE "ProductName", "PrintShift\0"
      VALUE "ProductVersion", "@PRINTSHIFT_VERSION@\0"
      VALUE "OriginalFilename", "PrintShift.exe\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
